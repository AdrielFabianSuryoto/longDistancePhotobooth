# Salin file ini jadi .env.local lalu isi dari Supabase Dashboard > Settings > API Keys.
# Kedua nilai ini memang ikut ter-bundle ke JavaScript yang dikirim ke browser —
# itu normal. Yang mengamankan data adalah Row Level Security, bukan kerahasiaan key.
# JANGAN pernah menaruh service_role / secret key di sini.

VITE_SUPABASE_URL=https://asiamvbvqdvzhcluriea.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opsional. Isi ini kalau video pasangan macet di "Connecting..." saat kalian
# di jaringan yang benar-benar berbeda (data seluler, kantor/kampus, WiFi
# rumah lain). Tanpa TURN, koneksi video hanya berhasil kalau kedua jaringan
# sama-sama mengizinkan sambungan langsung — itu tidak selalu terjadi.
# Contoh penyedia gratis: https://www.metered.ca/tools/openrelay/
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
